# Hyperliquid API Credentials
# Copy this file to .env and fill in your credentials

# Your wallet private key (required for trading)
# Get this from your wallet (MetaMask, etc.)
# NEVER share this key with anyone!
# Use either PRIVATE_KEY or HYPERLIQUID_PRIVATE_KEY
PRIVATE_KEY=your_private_key_here

# Your wallet address (optional - derived from private key if not set)
# Use either WALLET_ADDRESS or HYPERLIQUID_ACCOUNT_ADDRESS
WALLET_ADDRESS=0xYourWalletAddress
